{
  "name": "bricko-voice-core",
  "version": "1.0.0",
  "description": "Voice agent for inbound WhatsApp Business calls (Asterisk AudioSocket + Gemini Live)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test:call": "ts-node scripts/test-call.ts",
    "meta:sip": "ts-node scripts/configure-meta-sip.ts",
    "test:language": "ts-node scripts/language-check/run.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
