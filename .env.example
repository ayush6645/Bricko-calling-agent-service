# Gemini Live API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-live-extended-thinking
GEMINI_VOICE=Charon
GEMINI_THINKING_LEVEL=LOW
# Optional overrides (defaults shown)
# GEMINI_HOST=generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1alpha
# GEMINI_OUTPUT_SAMPLE_RATE=24000
# Text model for post-call transcript processing and the language check
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TEXT_API_VERSION=v1beta

# Telephony Server Ingress (AudioSocket)
PORT=8000
# Use 127.0.0.1 on the VM: only the local Asterisk gateway should reach the agent
HOST=0.0.0.0
# Asterisk AudioSocket audio format: 16-bit mono PCM at this rate, in frames of this length
# TELEPHONY_SAMPLE_RATE=8000
# TELEPHONY_FRAME_MS=20

# Call behaviour
# Pause after the farewell finishes playing before the line is dropped
# CALL_HANGUP_GRACE_MS=1500
# Log both sides of the conversation, turn by turn (useful when verifying live calls)
# CALL_LOG_TRANSCRIPTS=false

# Caller-details endpoint the Asterisk gateway posts to (keep it on loopback).
# Must match AGENT_METADATA_URL in gateway/.env.
# METADATA_HOST=127.0.0.1
# METADATA_PORT=8001
# METADATA_PATH=/calls
# METADATA_MAX_BODY_BYTES=8192
# Drop caller details that no call claimed within this time
# METADATA_TTL_MS=60000

# Timezone for log timestamps (IANA name, e.g. Asia/Kolkata); call records always use UTC
# LOG_TIMEZONE=UTC

# Conversation languages (BCP-47 codes). Calls open in LANGUAGE_DEFAULT; the agent switches
# only to languages in LANGUAGE_SUPPORTED; unsupported languages get LANGUAGE_FALLBACK.
# LANGUAGE_SUPPORTED=hi-IN,en-IN,mr-IN,kn-IN,te-IN,bn-IN,ta-IN,gu-IN,ml-IN
# LANGUAGE_DEFAULT=hi-IN
# LANGUAGE_FALLBACK=hi-IN

# Post-call transcript processing (one text-model request per call, after it ends):
# per-turn language, the same words in Latin letters, and an English translation.
# If it fails, the call record is still saved with the original transcript.
# TRANSCRIPT_ENRICHMENT=true
# TRANSCRIPT_ENRICHMENT_TIMEOUT_MS=30000
# TRANSCRIPT_ENRICHMENT_ATTEMPTS=3

# Meta WhatsApp Cloud API (used by `npm run meta:sip`; the SIP hostname/port come from gateway/.env)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Use a permanent System User token; console tokens expire within a day
WHATSAPP_ACCESS_TOKEN=your_access_token
# META_GRAPH_API_VERSION=v23.0
