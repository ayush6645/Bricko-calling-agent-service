# =====================================================================
# BRICKO WHATSAPP SIP GATEWAY (Asterisk) CONFIGURATION
# Copy to gateway/.env and fill in. Rendered into Asterisk configs at
# container start by entrypoint.sh.
# =====================================================================

# Public DNS name Meta connects to. Must resolve to SIP_EXTERNAL_ADDRESS and
# match the TLS certificate. Used by `npm run meta:sip` to register with Meta.
SIP_PUBLIC_HOSTNAME=sip.example.com

# Network
SIP_BIND_ADDRESS=0.0.0.0
SIP_UDP_PORT=5060
SIP_TLS_PORT=5061
# Private subnet of the VM (traffic inside it is not NAT-rewritten)
SIP_LOCAL_NET=10.0.0.0/16
# Public IP of the VM, advertised to Meta for signaling and media
SIP_EXTERNAL_ADDRESS=203.0.113.10

# TLS (Meta requires a certificate from a public CA, e.g. Let's Encrypt)
SIP_TLS_METHOD=sslv23
SIP_TLS_CERT_FILE=/etc/asterisk/certs/fullchain.pem
SIP_TLS_KEY_FILE=/etc/asterisk/certs/privkey.pem

# Media: codecs offered to Meta (comma separated, in preference order)
SIP_ALLOWED_CODECS=opus,ulaw,alaw
# RTP port range; open the same UDP range in the VM firewall
RTP_PORT_START=10000
RTP_PORT_END=10100

# Meta identification: INVITEs from WhatsApp carry this header
META_SIP_MATCH_HEADER="X-FB-External-Domain: wa.meta.vc"

# Bricko Voice Core AudioSocket listener (agent HOST:PORT on the same VM)
AUDIOSOCKET_ADDRESS=127.0.0.1:8000

# Agent endpoint for caller details (agent METADATA_HOST:METADATA_PORT + METADATA_PATH).
# The call UUID is appended as /<uuid>. Seconds to wait before giving up on the post.
AGENT_METADATA_URL=http://127.0.0.1:8001/calls
AGENT_METADATA_TIMEOUT_SEC=2
